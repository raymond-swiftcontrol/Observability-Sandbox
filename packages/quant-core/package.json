{
  "name": "@helios/quant-core",
  "version": "0.14.0",
  "private": true,
  "description": "Pure-TypeScript quant math: indicators, statistics, performance, sizing, option pricing",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "catalog:",
    "vitest": "^2.1.8"
  }
}
