# ─────────────────────────────────────────────────────────────────────────────
# Helios — local development environment
# Copy to .env and adjust. Never commit the populated file.
# ─────────────────────────────────────────────────────────────────────────────
HELIOS_ENV=local
LOG_LEVEL=debug
TZ=UTC

# ── Core Postgres / TimescaleDB (OLTP + time series) ──────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=helios
POSTGRES_USER=helios
POSTGRES_PASSWORD=helios_dev_only
POSTGRES_SSLMODE=disable
DATABASE_URL=postgresql://helios:helios_dev_only@localhost:5432/helios?sslmode=disable
DATABASE_POOL_MAX=20
DATABASE_STATEMENT_TIMEOUT_MS=15000

# ── ClickHouse (analytics / tick archive) ─────────────────────────────────────
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DB=helios_analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# ── Redis (cache, rate limits, pub/sub fan-out, BullMQ) ───────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_STREAM_MAXLEN=100000

# ── Redpanda / Kafka (event backbone) ────────────────────────────────────────
KAFKA_BROKERS=localhost:19092
KAFKA_CLIENT_ID=helios
SCHEMA_REGISTRY_URL=http://localhost:18081
KAFKA_TOPIC_TICKS=md.ticks.v1
KAFKA_TOPIC_BARS=md.bars.v1
KAFKA_TOPIC_SIGNALS=strategy.signals.v1
KAFKA_TOPIC_ORDERS=oms.orders.v1
KAFKA_TOPIC_FILLS=oms.fills.v1
KAFKA_TOPIC_RISK=risk.assessments.v1

# ── Object storage (backtest artifacts, parquet feature store) ────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_ARTIFACTS=helios-artifacts
S3_BUCKET_FEATURES=helios-feature-store
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=replace_me_with_32_byte_random_string
JWT_REFRESH_SECRET=replace_me_with_another_32_byte_string
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
ARGON2_MEMORY_COST=19456
TOTP_ISSUER=Helios

# ── Service endpoints (internal mesh) ────────────────────────────────────────
API_GATEWAY_PORT=4000
QUANT_ENGINE_URL=http://localhost:8100
RISK_ENGINE_URL=http://localhost:8200
EXECUTION_GATEWAY_GRPC=localhost:9300
MARKET_DATA_GRPC=localhost:9400
NOTIFICATION_WORKER_PORT=4500

# ── Market data vendors (paper keys for local dev) ────────────────────────────
VENDOR_POLYGON_API_KEY=
VENDOR_ALPACA_KEY_ID=
VENDOR_ALPACA_SECRET=
VENDOR_BINANCE_KEY=
VENDOR_BINANCE_SECRET=
VENDOR_FRED_API_KEY=
MARKET_DATA_MODE=replay   # live | replay | synthetic

# ── Broker / execution venues ────────────────────────────────────────────────
BROKER_MODE=paper         # paper | live
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
IBKR_GATEWAY_HOST=localhost
IBKR_GATEWAY_PORT=4002

# ── Push notifications ───────────────────────────────────────────────────────
EXPO_ACCESS_TOKEN=
APNS_KEY_ID=
APNS_TEAM_ID=
FCM_PROJECT_ID=

# ── Observability ────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAMESPACE=helios
OTEL_TRACES_SAMPLER_ARG=0.25
PROMETHEUS_PORT=9464
SENTRY_DSN=

# ── Feature flags ────────────────────────────────────────────────────────────
FEATURE_OPTIONS_CHAIN=true
FEATURE_LIVE_TRADING=false
FEATURE_ML_SIGNALS=true
FEATURE_SOCIAL_LEADERBOARD=false
